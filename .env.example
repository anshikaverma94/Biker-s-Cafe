# ---------- Neon Postgres ----------
# Get this from your Neon project dashboard -> Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------- Razorpay ----------
# Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Public key is exposed to the browser via NEXT_PUBLIC_ prefix, must match RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks -> Add New Webhook. Generates confirmation
# server-to-server as a backup if the browser never calls back after payment.
RAZORPAY_WEBHOOK_SECRET=a-different-long-random-string

# ---------- Google Sheets (Apps Script web app, no GCP project needed) ----------
# See google-apps-script/Code.gs + README-SHEETS.md for setup steps.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec
SHEETS_WEBHOOK_SECRET=replace-with-a-long-random-string

# ---------- Facebook / Meta Pixel ----------
NEXT_PUBLIC_FB_PIXEL_ID=000000000000000
# Conversions API (server-side) access token, from Events Manager -> Settings
FB_CONVERSIONS_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: used to de-dupe/verify test events in Events Manager
FB_TEST_EVENT_CODE=

# ---------- Misc ----------
# Base URL of the deployed site, used for server-side links/redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
